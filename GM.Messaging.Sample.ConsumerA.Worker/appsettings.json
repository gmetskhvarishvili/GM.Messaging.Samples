{
  "Admin": {
    "ApiKey": "local-dev-admin-key"
  },
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=messaging_consumer_a;Username=postgres;Password=123456",
    "SubjectKeys": "Host=localhost;Port=5432;Database=messaging_keys;Username=postgres;Password=123456"
  },
  "ConsumerTopology": {
    "DeadLetterQueue": "gm.dead-letters",
    "Bindings": [
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-a.orders",   "RoutingKey": "order.placed" },
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-a.users",    "RoutingKey": "user.registered" },
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-a.payments", "RoutingKey": "payment.processed" },
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-a.erasure",  "RoutingKey": "subject.forgotten" }
    ]
  },
  "Messaging": {
    "SensitiveData": {
      "CurrentKeyId": "sample-2026-11",
      // The Data Protection keys that unprotect dp: keys (GM.Messaging's own; the app's is left alone).
      "DataProtection": { "KeysPath": "../deploy/dataprotection", "ApplicationName": "GM.Messaging.Sample" },
      "Keys": {
        "sample-2026-11": "0jhLQs7AjRkn9OLKULOvcGKQOili1qobbLtbx54iNF8=",
        // Rotation (CI switches CurrentKeyId to it): protected with Data Protection, no raw key here.
        "sample-2026-12": "dp:CfDJ8IIqVXqQTlBMilxVLWaETfAH3NReVOPVIFJ6UbB3qhIc7PXLy2UrutkS0fXR92g3HxZfj1O-4mGsVlEoL5UpPFpeC90SXkIRCPXE0hdbyvz5cYetpgOl0gAH9udV0hRLPGVp6ZoB3P7PxSMKhLfZVE2kGSamIx09En7r_IwM3CyM"
      }
    },
    "ServiceName": "GM.Messaging.Sample.ConsumerA.Worker",
    "RabbitMq": {
      "HostName":    "localhost",
      "Port":        5671,
      "VirtualHost": "/",
      // Mutual TLS: ConsumerA signs in with its client certificate (CN=gm-consumer-a, RabbitMQ's EXTERNAL
      // mechanism), not a password; the user has none.
      "UserName":    "gm-consumer-a",
      "QueueType":   "Quorum",
      "UseTls":      true,
      "TlsCaCertificatePath": "../deploy/tls/certs/ca.pem",
      "TlsClientCertificatePath": "../deploy/tls/certs/consumer-a.pem",
      "TlsClientKeyPath": "../deploy/tls/certs/consumer-a.key",
      "UseExternalAuthentication": true
    },
    "Retry": {
      "MaxAttempts":              3,
      "InitialDelayMilliseconds": 250
    },
    "CircuitBreaker": {
      "Enabled":                    true,
      "TrackingPeriodSeconds":      60,
      "PauseTimeSeconds":           30,
      "FailurePercentageThreshold": 25,
      "MinimumThreshold":           10
    },
    "Inbox": {
      "ConsumerName":  "consumer-a",
      "RetentionDays": 30
    }
  },
  "Logging": {
    "LogLevel": {
      "Default":  "Information",
      "Wolverine": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
