  },
  "ConsumerTopology": {
    "DeadLetterQueue": "gm.dead-letters",
    "Bindings": [
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-a.orders",   "RoutingKey": "order.placed" },
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-a.users",    "RoutingKey": "user.registered" },
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-a.payments", "RoutingKey": "payment.processed" }
    ]
  },
  "Messaging": {
    "SensitiveData": {
      "CurrentKeyId": "sample-2026-11",
