    },
    "ServiceName": "GM.Messaging.Sample.ConsumerA.Worker",
    "RabbitMq": {
      "HostName":    "localhost",
      "Port":        5671,
      "VirtualHost": "/",
      "UserName":    "gm-consumer-a",
