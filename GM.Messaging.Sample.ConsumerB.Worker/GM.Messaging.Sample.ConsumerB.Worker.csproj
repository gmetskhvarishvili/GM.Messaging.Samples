<Project Sdk="Microsoft.NET.Sdk.Worker">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>GM.Messaging.Sample.ConsumerB.Worker</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
        <!-- Held at 10.0.10 to match GM.Messaging.Persistence's own pinned EF Core floor; a newer direct reference here creates an unresolved Microsoft.EntityFrameworkCore.Relational version conflict (MSB3277). -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GM.Messaging.Sample.ConsumerB.Infrastructure\GM.Messaging.Sample.ConsumerB.Infrastructure.csproj" />
        <ProjectReference Include="..\GM.Messaging.Sample.ConsumerB.Persistence\GM.Messaging.Sample.ConsumerB.Persistence.csproj" />
        <ProjectReference Include="..\GM.Messaging.Sample.Domain\GM.Messaging.Sample.Domain.csproj" />
    </ItemGroup>

</Project>
