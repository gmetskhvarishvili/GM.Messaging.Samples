{
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=messaging_consumer_b;Username=postgres;Password=123456"
  },
  "Database": {
    "Schema": "consumer_b"
  },
  "ConsumerTopology": {
    "DeadLetterQueue": "gm.dead-letters",
    "Bindings": [
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-b.orders",    "RoutingKey": "order.placed" },
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-b.users",     "RoutingKey": "user.registered" },
      { "Exchange": "gm.events", "Kind": "Topic", "Queue": "gm.consumer-b.inventory", "RoutingKey": "inventory.#" }
    ]
  },
  "Messaging": {
    "ServiceName": "GM.Messaging.Sample.ConsumerB.Worker",
    "RabbitMq": {
      "HostName":    "localhost",
      "Port":        5672,
      "VirtualHost": "/",
      "UserName":    "guest",
      "Password":    "guest"
    },
    "Retry": {
      "MaxAttempts":              5,
      "InitialDelayMilliseconds": 250
    },
    "CircuitBreaker": {
      "Enabled":                    true,
      "TrackingPeriodSeconds":      60,
      "PauseTimeSeconds":           30,
      "FailurePercentageThreshold": 25,
      "MinimumThreshold":           10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default":  "Information",
      "Wolverine": "Information"
    }
  }
}
