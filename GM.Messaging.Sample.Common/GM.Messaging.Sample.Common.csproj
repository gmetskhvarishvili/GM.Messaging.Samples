<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GM.Exceptions" Version="1.3.0" />
        <!-- MessagingTelemetry.Name, and the OpenTelemetry setup every host shares (Telemetry/). -->
        <PackageReference Include="GM.Messaging.Persistence" Version="4.9.0" />
        <!-- MapGMMessagingAdmin, shared by every host (Admin/). -->
        <PackageReference Include="GM.Messaging.AspNetCore" Version="4.9.0" />
        <!-- The provider for the shared subject-key database (KeyManagement/). -->
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
        <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    </ItemGroup>

</Project>
