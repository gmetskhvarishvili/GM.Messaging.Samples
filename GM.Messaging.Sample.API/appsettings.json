  "DataProtection": { "KeysPath": "../deploy/dataprotection" },
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=messaging_api;Username=postgres;Password=123456",
    "SubjectKeys": "Host=localhost;Port=5432;Database=messaging_keys;Username=postgres;Password=123456"
  },
  "Messaging": {
    "SensitiveData": {
      "CurrentKeyId": "sample-2026-11",
      "Keys": {
        "sample-2026-11": "0jhLQs7AjRkn9OLKULOvcGKQOili1qobbLtbx54iNF8=",
        // Rotation (CI switches CurrentKeyId to it): protected with Data Protection, no raw key here.
        "sample-2026-12": "dp:CfDJ8IIqVXqQTlBMilxVLWaETfAH3NReVOPVIFJ6UbB3qhIc7PXLy2UrutkS0fXR92g3HxZfj1O-4mGsVlEoL5UpPFpeC90SXkIRCPXE0hdbyvz5cYetpgOl0gAH9udV0hRLPGVp6ZoB3P7PxSMKhLfZVE2kGSamIx09En7r_IwM3CyM"
      }
    },
    "ServiceName": "GM.Messaging.Sample.API",
    "RabbitMq": {
      "HostName":    "localhost",
      "Port":        5671,
      "VirtualHost": "/",
      "UserName":    "gm-api",
      "Password":    "api-secret",
      "UseTls":      true,
      "TlsCaCertificatePath": "../deploy/tls/certs/ca.pem"
    },
    "OutboxRelay": {
      "WakeUpExchange": "gm.outbox.wake-up"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SwaggerDocOptions": {
    "Title": "GM Messaging API",
    "Description": "GM Sample Messaging API",
    "Contact": {
      "Name": "Giorgi Metskhvarishvili",
      "Email": "gmetskhvarishvili95@gmail.com",
      "Url": "https://metskhvarishvili.com"
    },
    "License": {
      "Name": "License",
      "Url": "https://opensource.org/licenses/MIT"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog",
      "Serilog.Sinks.Async",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Graylog",
      "Serilog.Enrichers.HttpContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Migrations": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Model.Validation": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithHttpContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:G} {Level:u3} {Message:lj}{NewLine:1}{Exception:1}"
        }
      }
    ]
  }
}

