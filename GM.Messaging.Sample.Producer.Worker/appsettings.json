{
  "Admin": {
    "ApiKey": "local-dev-admin-key"
  },
  "ConnectionStrings": {
    "ApplicationDatabase": "Host=localhost;Port=5432;Database=messaging_api;Username=postgres;Password=123456",
    "SubjectKeys": "Host=localhost;Port=5432;Database=messaging_keys;Username=postgres;Password=123456"
  },
  "ProducerTopology": {
    "Routes": [
      { "MessageType": "orders.order-placed",         "Exchange": "gm.events", "Kind": "Topic", "RoutingKey": "order.placed" },
      { "MessageType": "users.user-registered",       "Exchange": "gm.events", "Kind": "Topic", "RoutingKey": "user.registered" },
      { "MessageType": "payments.payment-processed",  "Exchange": "gm.events", "Kind": "Topic", "RoutingKey": "payment.processed" },
      { "MessageType": "inventory.inventory-updated", "Exchange": "gm.events", "Kind": "Topic", "RoutingKey": "inventory.updated" },
      { "MessageType": "returns.return-requested",    "Exchange": "gm.events", "Kind": "Topic", "RoutingKey": "returns.requested" },
      { "MessageType": "gm.subject-forgotten",        "Exchange": "gm.events", "Kind": "Topic", "RoutingKey": "subject.forgotten" }
    ]
  },
  "Messaging": {
    "SensitiveData": {
      "CurrentKeyId": "sample-2026-11",
      // The Data Protection keys that unprotect dp: keys (GM.Messaging's own; the app's is left alone).
      "DataProtection": { "KeysPath": "../deploy/dataprotection", "ApplicationName": "GM.Messaging.Sample" },
      "Keys": {
        "sample-2026-11": "0jhLQs7AjRkn9OLKULOvcGKQOili1qobbLtbx54iNF8=",
        // Rotation (CI switches CurrentKeyId to it): protected with Data Protection, no raw key here.
        "sample-2026-12": "dp:CfDJ8IIqVXqQTlBMilxVLWaETfAH3NReVOPVIFJ6UbB3qhIc7PXLy2UrutkS0fXR92g3HxZfj1O-4mGsVlEoL5UpPFpeC90SXkIRCPXE0hdbyvz5cYetpgOl0gAH9udV0hRLPGVp6ZoB3P7PxSMKhLfZVE2kGSamIx09En7r_IwM3CyM"
      }
    },
    "ServiceName": "GM.Messaging.Sample.Producer.Worker",
    "RabbitMq": {
      "HostName":          "localhost",
      "Port":              5671,
      "VirtualHost":       "/",
      "UserName":          "gm-producer",
      "Password":          "producer-secret",
      "UseTls":      true,
      "TlsCaCertificatePath": "../deploy/tls/certs/ca.pem",
      "PublisherConfirms": true
    },
    "Retry": {
      "MaxAttempts":              5,
      "InitialDelayMilliseconds": 250
    },
    "CircuitBreaker": {
      "Enabled":                    true,
      "TrackingPeriodSeconds":      60,
      "PauseTimeSeconds":           30,
      "FailurePercentageThreshold": 25,
      "MinimumThreshold":           10
    },
    "OutboxRelay": {
      "BatchSize":              50,
      "PollingIntervalSeconds": 30,
      "MaxRetries":             5,
      "RetryBaseDelaySeconds":  2,
      "RetryMaxDelaySeconds":   60,
      "LeaseSeconds":           60,
      "RetentionDays":          7,
      "WakeUpExchange":         "gm.outbox.wake-up"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default":  "Information",
      "Wolverine": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
